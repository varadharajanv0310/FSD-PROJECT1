# ─── Poise configuration ────────────────────────────────────────────────
# Copy this file to `.env` (in the repo root) and adjust as needed.
# Every value is optional in development — sensible defaults are built in.

# MongoDB connection string. `docker compose up -d mongo` starts one locally,
# or paste a free MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/poise

# Secret used to sign session cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── AI engine ──────────────────────────────────────────────────────────
# auto   → use Claude when ANTHROPIC_API_KEY is set, otherwise the offline engine
# claude → always try Claude (falls back to offline on errors)
# local  → always use the offline engine
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Server ─────────────────────────────────────────────────────────────
PORT=4000
# Origin(s) allowed to call the API with cookies (comma-separated).
CLIENT_ORIGIN=http://localhost:5173
# Enables the one-click "Explore the demo" account with sample history.
DEMO_ACCOUNT=true
# Serve the built React app from the API server (defaults to true in production).
# SERVE_CLIENT=true
