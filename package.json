{
  "name": "poise",
  "private": true,
  "version": "1.0.0",
  "description": "Poise — an AI-based interview practice & feedback system: mock interviews, question generation and automated feedback.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w server",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
