{
  "name": "@poise/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Poise API — Express, MongoDB and the AI interview engine.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "morgan": "^1.10.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@poise/shared": "*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
